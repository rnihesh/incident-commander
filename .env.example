# Copy to api/.env for local development, or to ./.env (repo root) for the
# `docker compose --profile prod` deploy (Compose reads ./.env for interpolation and
# passes it to the api container). See docs/notes/deploy.md.

# FalkorDB (dev: localhost:16379, no auth). In the prod profile this is set by
# docker-compose.yml to falkor://ic:${FALKORDB_IC_PASSWORD}@falkordb-prod:6379.
IC_FALKORDB_URL=falkor://localhost:16379

# LLM (OpenAI-compatible endpoints). provider: openai (default model gpt-6-luna) | anthropic
# (claude-haiku-5-5) | gemini | ollama (qwen3:8b, local). Model and base_url are optional.
IC_LLM_PROVIDER=openai
IC_LLM_BASE_URL=
IC_LLM_MODEL=
IC_LLM_API_KEY=
# auto: OpenAI embeddings only with an OpenAI key | hashing | openai. Re-run `ic seed` after changing.
IC_EMBEDDING_PROVIDER=auto
IC_EMBEDDING_MODEL=text-embedding-3-small
IC_EMBEDDING_DIMS=512

# Actions (fine-grained PAT, sandbox repo only: Contents, Pull requests, Commit statuses)
IC_GITHUB_TOKEN=
IC_GITHUB_REPO=
IC_DISCORD_WEBHOOK_URL=
IC_ALERT_HMAC_SECRET=

# Web origin allowed by CORS (dev). The prod profile uses https://${SITE_ADDRESS}.
IC_WEB_ORIGIN=http://localhost:3001
# The session cookie is Secure by default; plain-http localhost needs false, or the
# browser drops it. Never set false in prod.
# IC_COOKIE_SECURE=false

# Limits and budgets (KTD10)
IC_MAX_SESSIONS=8
# Daily LLM spend cap in USD (code default 5.0); kept low here for local runs.
IC_DAILY_USD_BREAKER=0.5
IC_ACTIONS_PER_HOUR=20
IC_SESSION_RUNS_PER_HOUR=3
IC_IP_CONCURRENT_SESSIONS=2
IC_IP_SESSIONS_PER_HOUR=6
IC_IP_RUNS_PER_HOUR=6
IC_GLOBAL_RUNS_PER_HOUR=60
IC_SESSION_IDLE_TTL_S=1800
# Per-session caps: Ask-the-graph questions, chain verifies, fragility maps (per hour)
# IC_SESSION_ASKS_PER_HOUR=20
# IC_SESSION_VERIFIES_PER_HOUR=30
# IC_SESSION_FRAGILITY_PER_HOUR=10
# Public proof page re-verify: per-IP hourly cap and per-proof debounce (seconds)
IC_PROOF_VERIFIES_PER_IP_HOUR=12
IC_PROOF_RERUN_INTERVAL_S=60

# Local state
IC_STORE_PATH=./data/ic.sqlite3

# Postgres twin (local Postgres.app with pgvector; benchmark only, not deployed)
IC_POSTGRES_DSN=postgresql://localhost:5432/ic

# --- prod profile only (docker compose --profile prod) ----------------------------------
# One origin: Caddy serves SITE_ADDRESS with TLS, /api/* goes to the API, the rest to the
# Next.js server. The API's allowed origin defaults to https://${SITE_ADDRESS}
# (set IC_WEB_ORIGIN_PROD to override).
SITE_ADDRESS=
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=
# Empty: host-only session cookie (single origin). Secure is always on in prod.
IC_COOKIE_DOMAIN=
# Who may set X-Forwarded-For: Caddy's fixed address on the compose edge network. Keep in
# sync with docker-compose.yml (networks.edge, caddy.ipv4_address).
IC_TRUSTED_PROXIES=["172.30.213.10"]
# FalkorDB ACL passwords (24+ chars, URL-safe: `openssl rand -hex 32`). `ic` is the API's
# user; `admin` is for operators only. The `default` user is disabled.
FALKORDB_IC_PASSWORD=
FALKORDB_PASSWORD=
# FalkorDB memory cap (noeviction: writes fail instead of evicting graphs). About 150 MB
# for the seed world plus about 58 MB per live session; size it with IC_MAX_SESSIONS.
FALKORDB_MAXMEMORY=2gb
